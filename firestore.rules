rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.get('role', '') == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isAssignedDriver() {
      return hasRole('driver') && resource.data.assignedDriverId == request.auth.uid;
    }

    function isoServiceDay(value) {
      let parts = value.split('T');
      let date = parts[0].split('-');
      let day = timestamp.date(int(date[0]), int(date[1]), int(date[2]));
      // Dart's unsuffixed date is already local. A Z instant can fall on the next IST day.
      return value.matches('.*Z') ? (day + duration.value(330, 'm') +
        duration.value(int(parts[1].split(':')[0]), 'h') +
        duration.value(int(parts[1].split(':')[1]), 'm')).date() : day;
    }

    function beforeMealCutoff() {
      let delivery = resource.data.deliveryDate;
      let nowIst = request.time + duration.value(330, 'm');
      // Check the trusted clock AND service day: a missed kitchen lock must not reopen at midnight.
      return nowIst.hours() < 21 && (
        (delivery is timestamp && (delivery + duration.value(330, 'm')).date() > nowIst.date()) ||
        (delivery is string &&
         delivery.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,9})?Z?)?') &&
         isoServiceDay(delivery) > nowIst.date())
      );
    }

    // User Profile Document
    match /users/{userId} {
      function validProfileEdit() {
        return request.resource.data.name is string &&
               request.resource.data.phoneNumber is string &&
               request.resource.data.clusterName is string &&
               request.resource.data.updatedAt == request.time;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && validProfileEdit() &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'phoneNumber', 'clusterName', 'role', 'createdAt', 'updatedAt'
        ]) && request.resource.data.uid == userId &&
        request.resource.data.role == 'customer' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (isOwner(userId) && validProfileEdit() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phoneNumber', 'clusterName', 'updatedAt'
        ]));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Pre-configured Delivery Clusters
    match /clusters/{clusterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Pass Subscriptions
    match /passes/{passId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      // No client writes. Verified issuance and ledger maintenance must run on the server.
    }

    // Meal Tickets Ledger
    match /meal_tickets/{ticketId} {
      allow read: if isAdmin() || isOwner(resource.data.userId) || isAssignedDriver();

      // Purchase, paid add-ons, skip/replacement and driver assignment are server writes.
      // DELIVERED is server-only too: the rider uploads delivery_proofs/{ticketId}/proof
      // and the finalizeDeliveryProof function marks the ticket (founder rule: photo proof).
      allow update: if isOwner(resource.data.userId) && resource.data.status == 'SCHEDULED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comboSelection']) &&
        request.resource.data.comboSelection in ['A', 'B'] && beforeMealCutoff();
    }

    // Money kept from a double or late payment. Only the server writes it;
    // ops refunds it by hand if the customer asks.
    match /customer_credits/{creditId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
    }

    // Daily Inventory & Batch Locks
    match /daily_inventory/{date} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // No manifest assignment schema or driver manifest writer exists in this client.
    match /driver_manifests/{manifestId} {
      allow read, write: if isAdmin();
    }

    // Kitchen Batches (21:01 IST Aggregations)
    match /kitchen_batches/{batchId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if isAdmin();
    }

    // Partner Tiffin Kitchens & Menus (Live sync with Web Admin)
    match /tiffin_shops/{shopId} {
      allow read: if true; // Publicly readable for customer apps
      allow write: if isAdmin();

      match /dishes/{dishId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Promotional Offers & Home Banners
    match /offers/{offerId} {
      allow read: if true; // Publicly readable for discounts & banners
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}
